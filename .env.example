# Copied to .env by `npm run setup`, which also fills in the LiveKit secret.
# Read by docker compose, the TypeScript apps (node --env-file) and the Python sidecars.

# LiveKit. Backends use ws://localhost:7880 directly: Node and Python don't trust the
# local Caddy CA that browsers use on wss://livekit.localhost.
LIVEKIT_URL=ws://localhost:7880
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=

# Temporal
TEMPORAL_ADDRESS=localhost:7233
TEMPORAL_NAMESPACE=default
TRANSLATOR_PORT=3100

# Conversation memory
OPENSEARCH_URL=http://localhost:9201
MEMORY_INDEX=conversation-memory

# LLM (LM Studio). Must honour reasoning_effort=none: gemma-4-e4b leaks its thinking when it's off.
LLM_BASE_URL=http://localhost:1234/v1
LLM_MODEL=google/gemma-4-26b-a4b

# Speech (services/mlx-audio)
SPEECH_BASE_URL=http://localhost:8000/v1
STT_MODEL=mlx-community/parakeet-tdt-0.6b-v2
TTS_MODEL=mlx-community/Kokoro-82M-8bit
TTS_VOICE=af_heart

# Laya decision model (services/laya)
LAYA_BASE_URL=http://localhost:8100
LAYA_MODEL=aac6fef/laya-multilingual-mlx

# Speech-to-speech model (services/voicechat), only for AGENT=s2s
VOICECHAT_URL=ws://localhost:8200
VOICECHAT_MODEL=mlx-community/NemotronLabs-VoiceChat-11B-8bit

# Hybrid agent (services/omni): Qwen3-Omni hears the user, Kokoro speaks
OMNI_BASE_URL=http://localhost:8300/v1
OMNI_MODEL=mlx-community/Qwen3-Omni-30B-A3B-Instruct-4bit
# the model also reads the turn's transcript after hearing it (measured: needed for reliable tool calls)
OMNI_TRANSCRIPT_WITH_AUDIO=1
