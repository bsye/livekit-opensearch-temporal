# Credentials for tools and backends that talk to this LiveKit server
# (lk CLI, Agents SDK, server SDKs). Must match the `keys` in livekit.yaml.
#
# ws://localhost:7880 bypasses Caddy on purpose: Python/Node don't use the macOS
# keychain, so they'd reject Caddy's local certificate on wss://livekit.localhost.
# Browsers can use wss://livekit.localhost.
LIVEKIT_URL=ws://localhost:7880
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# Local voice pipeline (agents/voice-agent), all OpenAI-compatible APIs
# Everything runs natively on the Apple GPU (Docker on macOS has no Metal access).
# LLM: LM Studio server (`lms server start`); reasoning is disabled per request for latency.
# Needs a model that honours reasoning_effort=none: gemma-4-e4b (MLX) leaks its thinking
# into the reply when thinking is disabled, and thinks for 1-7s when it isn't.
LLM_BASE_URL=http://localhost:1234/v1
LLM_MODEL=google/gemma-4-26b-a4b
# STT + TTS: mlx-audio (services/mlx-audio/run.sh)
# parakeet ~60ms per utterance (English); mlx-community/whisper-large-v3-turbo-asr-fp16 ~720ms, multilingual
SPEECH_BASE_URL=http://localhost:8000/v1
STT_MODEL=mlx-community/parakeet-tdt-0.6b-v2
# 8-bit Kokoro: ~200ms to first audio vs ~390ms for bf16
TTS_MODEL=mlx-community/Kokoro-82M-8bit
TTS_VOICE=af_heart

# Action gate (agents/voice-agent): Laya decision model, local MLX (services/laya/run.sh).
# Jev-compatible API, so TypeSafe's hosted Jev could be swapped in by URL.
LAYA_BASE_URL=http://localhost:8100
LAYA_MODEL=aac6fef/laya-multilingual-mlx

# Conversation memory (docker compose service; no auth, local only)
OPENSEARCH_URL=http://localhost:9201
MEMORY_INDEX=conversation-memory

# Speech-to-speech model (services/voicechat): NVIDIA NemotronLabs VoiceChat on MLX
VOICECHAT_URL=ws://localhost:8200
VOICECHAT_MODEL=mlx-community/NemotronLabs-VoiceChat-11B-8bit
