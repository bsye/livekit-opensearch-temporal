{
  "name": "livekit-temporal",
  "private": true,
  "type": "module",
  "description": "Translates LiveKit webhooks into Temporal RoomSession workflows",
  "scripts": {
    "translator": "node --env-file=../../.env --import tsx src/translator.ts",
    "worker": "node --env-file=../../.env --import tsx src/worker.ts",
    "typecheck": "tsc --noEmit",
    "backfill-memory": "node --env-file=../../.env --import tsx src/backfill-memory.ts",
    "load-library": "node --max-old-space-size=6144 --env-file=../../.env --import tsx src/load-longmemeval.ts"
  },
  "dependencies": {
    "@huggingface/transformers": "^4.3.0",
    "@temporalio/client": "^1.24.0",
    "@temporalio/common": "^1.24.0",
    "@temporalio/worker": "^1.24.0",
    "@temporalio/workflow": "^1.24.0",
    "livekit-server-sdk": "^2.19.1",
    "stream-json": "^1.9.1"
  },
  "devDependencies": {
    "@types/node": "^20.19.43",
    "@types/stream-json": "^1.7.8",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  },
  "exports": {
    "./shared": "./src/shared.ts",
    "./client": "./src/client.ts",
    "./memory": "./src/memory.ts",
    "./rerank": "./src/rerank.ts"
  }
}
