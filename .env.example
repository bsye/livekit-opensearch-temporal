# Credentials for tools and backends that talk to this LiveKit server
# (lk CLI, Agents SDK, server SDKs). Must match the `keys` in livekit.yaml.
#
# ws://localhost:7880 bypasses Caddy on purpose: Python/Node don't use the macOS
# keychain, so they'd reject Caddy's local certificate on wss://livekit.localhost.
# Browsers can use wss://livekit.localhost.
LIVEKIT_URL=ws://localhost:7880
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# Local voice pipeline (agents/voice-agent), all OpenAI-compatible APIs
# LLM: LM Studio server (`lms server start`); reasoning is disabled per request for latency
LLM_BASE_URL=http://localhost:1234/v1
LLM_MODEL=google/gemma-4-26b-a4b
# STT + TTS: speaches (docker compose service)
SPEECH_BASE_URL=http://localhost:8000/v1
STT_MODEL=Systran/faster-whisper-small.en
TTS_MODEL=speaches-ai/Kokoro-82M-v1.0-ONNX
TTS_VOICE=af_heart
